POSTGRES_USER=meetings
POSTGRES_PASSWORD=meetings
POSTGRES_DB=meetings
# Host port for Postgres (change if 5432 is already in use)
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://meetings:meetings@db:5432/meetings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Auth (Cognito) ---
# Filled in by `make deploy-auth` (these are public IDs, not secrets). Local runs use the same
# user pool as AWS. The backend only accepts ID tokens from this pool and app client.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
COGNITO_GOOGLE_ENABLED=false
# Google sign-in: create an OAuth client in Google Cloud with the redirect URI
# https://<COGNITO_DOMAIN>/oauth2/idpresponse, set both values, and run make deploy-auth.
# Leave empty to keep Google disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AWS deployment (make deploy-backend) ---
# Credentials of an IAM user allowed to manage CloudFormation, Lambda, EC2/VPC, RDS, ECR,
# IAM roles, SSM Parameter Store, S3, CloudFront, CloudWatch Logs, and for a custom domain
# ACM and Route 53. Never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary (STS) credentials
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# Prefix for all AWS resource and stack names; every resource is tagged PROJECT_NAME=<this>
PROJECT_NAME=new-project
# Extra origins allowed to call the deployed API, comma-separated. The CloudFront address
# and the custom domain are added automatically.
CORS_ORIGINS_AWS=
# Weekly report (make deploy-reports): the address that sends and receives it. SES emails a
# verification link to it; while the account is in the SES sandbox that address must be verified.
# The IAM user also needs SQS, EventBridge Scheduler and SES.
REPORT_EMAIL=
# Optional: when the report is built, in Europe/Kyiv time. Default: cron(0 7 ? * MON *).
# For a test run: rate(5 minutes) (set it back afterwards).
REPORT_SCHEDULE=
# Backend Lambda memory in MB (CPU scales with it; 400,000 GB-seconds/month are free)
LAMBDA_MEMORY=512

# --- Custom domain (make add-domain, after make deploy) ---
# Host name for the frontend, e.g. app.example.com. Leave empty for the *.cloudfront.net address.
DOMAIN_NAME=
# Optional Route 53 hosted zone id of DOMAIN_NAME (e.g. Z0123456789ABC). If set, the DNS records
# are created for you; otherwise make add-domain prints the records to add at your DNS provider.
HOSTED_ZONE_ID=

# --- Agenda parser (make deploy-ai) ---
# Claude on Amazon Bedrock, us-east-1. Needs access to the model in Bedrock -> Model catalog.
PARSER_MODEL=anthropic.claude-opus-5-5
PARSER_PROVIDER=bedrock
# Without access to Anthropic models: Amazon Nova through the Converse API.
# PARSER_MODEL=us.amazon.nova-2-lite-v1:0
# PARSER_PROVIDER=converse
# Printed by make deploy-ai; the frontend is built against it (make deploy-frontend).
AGENDA_PARSER_URL=
